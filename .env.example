# Backend and worker: Node.js 22+, persistent disk, separate operations bot.
DARLING_DATA_DIR=./data
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
TELEGRAM_BOT_TOKEN=
# Random 32+ character secret for Telegram webhook authentication.
TELEGRAM_WEBHOOK_SECRET=
# Random 32+ character backend token. Bind ONE WorkBuddy installation to ONE user.
DARLING_AGENT_TOKEN=
# Numeric Telegram user ID. Start a private chat with the operations bot first.
DARLING_AGENT_OWNER=
# 32 random bytes encoded as 64 hexadecimal characters; back up securely.
CREDENTIAL_ENCRYPTION_KEY=
# Google web OAuth client; callback is PUBLIC_BASE_URL/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WorkBuddy desktop operations MCP adapter:
DARLING_BACKEND_URL=https://your-domain.example
# Legacy local MCP only (not the multi-user HTTP endpoint):
CAMPUS_EVENT_DB_PATH=./data/legacy-events.sqlite
TALLY_API_KEY=
